    <PackageReference Include="AspNetCoreRateLimit" Version="5.0.0" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.34" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.10" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- Regional Flavours seed stories (RegionSeeder inserts missing regions only) -->
    <EmbeddedResource Include="Services\Seed\regions.seed.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WahSpices.Application\WahSpices.Application.csproj" />
    <ProjectReference Include="..\WahSpices.Infrastructure\WahSpices.Infrastructure.csproj" />
